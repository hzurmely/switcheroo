{
  "name": "switcheroo",
  "productName": "Switcheroo",
  "version": "2.7.12",
  "description": "Tests two Wi-Fi networks in the background and switches to the faster one.",
  "main": "main.js",
  "author": "hzurmely",
  "license": "MIT",
  "homepage": "https://github.com/hzurmely/switcheroo",
  "scripts": {
    "start": "electron .",
    "test": "node engine.test.js && node retry.test.js && node detect.test.js && node games.test.js && node traylabel.test.js && node bench.test.js && node linux.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hzurmely.switcheroo",
    "productName": "Switcheroo",
    "files": [
      "*.js",
      "python/*.py",
      "index.html",
      "style.css",
      "*.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "Switcheroo-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hzurmely",
        "repo": "switcheroo"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "Switcheroo-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Network",
      "synopsis": "Switches to the faster Wi-Fi network",
      "maintainer": "hzurmely <hzurmely@users.noreply.github.com>",
      "artifactName": "Switcheroo-${version}-linux-${arch}.${ext}"
    },
    "asarUnpack": [
      "python/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}